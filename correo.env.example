# Correo REAL para la demo. Copie este archivo como «correo.env» (no se sube al repositorio),
# complete UNA de las opciones y levante la demo con:
#   docker compose --env-file correo.env -f docker-compose.demo.yml up --build
# Luego pruebe:  docker compose -f docker-compose.demo.yml exec web php artisan plataforma:correo:probar su@correo.com
#
# La contraseña SMTP es suya: se escribe solo en este archivo de su computadora, nunca en el código ni en un chat.

# --- Opción A: Brevo (gratis hasta 300 correos al día) ---------------------------------------
# En brevo.com: cree la cuenta, verifique su remitente y genere una «clave SMTP» en
# Configuración > SMTP y API. El usuario es el que muestra esa misma pantalla.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Escobar Net DTE"

# --- Opción B: Gmail (solo para pruebas; Google limita el envío) ------------------------------
# Requiere la verificación en dos pasos y una «contraseña de aplicación» (myaccount.google.com >
# Seguridad > Contraseñas de aplicaciones). El remitente debe ser la misma cuenta de Gmail.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=su.cuenta@gmail.com
# MAIL_PASSWORD=contraseña-de-aplicación-de-16-letras
# MAIL_FROM_ADDRESS=su.cuenta@gmail.com

# --- Opción C: Resend (requiere un dominio propio verificado) --------------------------------
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=resend
# MAIL_PASSWORD=su-api-key-de-resend
# MAIL_FROM_ADDRESS=facturas@su-dominio.com
