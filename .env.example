APP_NAME="Escobar Net DTE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/El_Salvador

# saas = multiempresa | dedicado = una sola empresa (mismo código)
APP_MODE=saas

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dte
DB_USERNAME=dte_app
DB_PASSWORD=dte_app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@escobarnet.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=dte-s3
AWS_SECRET_ACCESS_KEY=dte-s3-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=dte-archivo
AWS_ENDPOINT=http://127.0.0.1:8333
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# --- Motor DTE -------------------------------------------------------------
# 00 = pruebas, 01 = producción. Nunca 01 sin autorización de Hacienda.
DTE_AMBIENTE=00
DTE_USER_AGENT="EscobarNet-DTE/1.0"
DTE_FIRMADOR_URL=http://127.0.0.1:8113/firmardocumento/
# Llave dedicada para cifrar credenciales de los clientes (distinta de APP_KEY).
# Generar con: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
DTE_SECRETS_KEY=

# Solo para la prueba real contra Hacienda (grupo hacienda-pruebas).
# Los pone el usuario; jamás se suben al repositorio.
HACIENDA_PRUEBAS_NIT=
HACIENDA_PRUEBAS_PWD_API=
HACIENDA_PRUEBAS_PWD_PRIVADA=
