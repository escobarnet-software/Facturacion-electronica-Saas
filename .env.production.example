# Plantilla de producción (sin valores secretos). Cada secreto se carga desde el gestor de secretos del hosting.
# Verificar con: php artisan plataforma:revisar-produccion
APP_NAME="Escobar Net DTE"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://dte.ejemplo.sv
APP_KEY=
# Rotación: la llave anterior aquí (separadas por comas) hasta terminar la rotación.
APP_PREVIOUS_KEYS=
APP_LOCALE=es
APP_MODE=saas

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=dte
# Rol de la aplicación: NOSUPERUSER NOBYPASSRLS (si no, RLS no aplica).
DB_USERNAME=dte_app
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=
REDIS_PASSWORD=

FILESYSTEM_DISK=local
DTE_ARCHIVO_DISCO=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=dte@ejemplo.sv
MAIL_FROM_NAME="${APP_NAME}"

# Motor DTE
DTE_AMBIENTE=00
DTE_SECRETS_KEY=
DTE_SECRETS_PREVIOUS_KEYS=
DTE_FIRMADOR_URL=http://firmador:8113/firmardocumento/
DTE_ENTREGA_AUTOMATICA=true
DTE_SONDEO_HACIENDA=true
DTE_RECIBIDOS_VERIFICAR_PUBLICO=false

# Plataforma
PLATAFORMA_EMPRESA_ID=
ALERTA_COLA_MAXIMA=500
ALERTA_SILENCIO_MINUTOS=30
